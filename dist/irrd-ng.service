# systemd unit for irrd-ng, the drop-in replacement for IRRd 4.5.
#
# Install as /etc/systemd/system/irrd-ng.service. It runs irrd-ng the way
# IRRd v4's documented unit runs v4: started as root, in the foreground,
# with the same irrd.yaml. irrd-ng then does what v4 does: it writes
# irrd.pid in `piddir`, binds the whois port (43 needs root), switches to
# the `user` and `group` from irrd.yaml, and only then opens the store and
# binds the HTTP port. SIGHUP reloads irrd.yaml with v4's semantics.
#
# Before the first start:
#   - irrd.yaml sets `user` and `group` (irrd-ng, like v4, refuses to keep
#     running as root) and `piddir: /run/irrd` to match PIDFile and
#     RuntimeDirectory below. If you keep another piddir, change both.
#   - the store directory exists and belongs to that user:
#       install -d -o irrd -g irrd -m 0750 /var/lib/irrd-ng
#   - the binary and its tool name symlinks are in /usr/local/bin.
#
# No PostgreSQL or Redis dependency: irrd-ng ignores database_url and
# redis_url. Stop and disable v4's own unit before enabling this one, since
# both listen on the same ports.

[Unit]
Description=irrd-ng IRR server (IRRd 4.5 compatible)
Documentation=https://github.com/JoshFinlayAU/irrd-ng
Wants=network-online.target
After=network-online.target
Conflicts=irrd.service

[Service]
Type=simple
User=root
Environment=IRRD_NG_STORE_PATH=/var/lib/irrd-ng
ExecStart=/usr/local/bin/irrd --foreground --config /etc/irrd.yaml
ExecReload=/bin/kill -HUP $MAINPID
# piddir in irrd.yaml must name this directory.
RuntimeDirectory=irrd
RuntimeDirectoryMode=0755
PIDFile=/run/irrd/irrd.pid
Restart=on-failure
RestartSec=5s
# irrd-ng logs `Main process exiting` once SIGTERM has stopped its jobs.
KillSignal=SIGTERM
KillMode=mixed
TimeoutStopSec=60s
LimitNOFILE=65536

# Hardening. Everything below leaves v4's behaviour intact: the process
# starts as root only to bind the whois port and change owner, and gives up
# every capability when it switches to `user`.
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_SETUID CAP_SETGID CAP_DAC_OVERRIDE
NoNewPrivileges=yes
ProtectSystem=full
# v4's own deployment guide keeps piddir, logs and exports under
# /home/irrd, so home directories stay writable. If nothing in your
# irrd.yaml points under /home, set ProtectHome=yes.
ProtectHome=no
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
