Content-Type: application/json

{"query": "{ __typename }", "operationName": ["a", 1]}
@end

@request POST /graphql/
Content-Type: application/json

{"query": "{ __typename }", "operationName": null, "variables": null}
@end

@request POST /graphql/
Content-Type: application/json

not json
@end

