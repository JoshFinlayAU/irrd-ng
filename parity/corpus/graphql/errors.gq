Content-Type: application/json; charset=utf-8

{"query": "{ __typename }"}
@end

@request POST /graphql/
Content-Type: text/plain

{"query": "{ __typename }"}
@end

@request POST /graphql/

{"query": "{ __typename }"}
@end

