# GraphQL suite: resolvers, arguments, fragments and errors, replayed
# against v4 and irrd-ng by tools/http_diff.py (parity/run.sh --suite
# graphql). Syntax: tools/http_diff.py and README.md here.

@tags introspection
@limit 1
@gql IntrospectionQuery
query IntrospectionQuery { __schema { queryType { name } mutationType { name } subscriptionType { name } types { ...FullType } directives { name description locations args { ...InputValue } } } }
fragment FullType on __Type { kind name description fields(includeDeprecated: true) { name description args { ...InputValue } type { ...TypeRef } isDeprecated deprecationReason } inputFields { ...InputValue } interfaces { ...TypeRef } enumValues(includeDeprecated: true) { name description isDeprecated deprecationReason } possibleTypes { ...TypeRef } }
fragment InputValue on __InputValue { name description type { ...TypeRef } defaultValue }
fragment TypeRef on __Type { kind name ofType { kind name ofType { kind name ofType { kind name ofType { kind name ofType { kind name ofType { kind name ofType { kind name } } } } } } } }
@end

@gql
{ __schema { description types { name kind specifiedByURL isOneOf } directives(includeDeprecated: true) { name isRepeatable isDeprecated deprecationReason args(includeDeprecated: true) { name defaultValue isDeprecated } } } }
@end

@gql
{ __type(name: "RPSLRoute") { name kind interfaces { name } fields { name type { name kind ofType { name kind ofType { name } } } } } }
@end

@gql
{ __type(name: "RPSLContactUnion") { name possibleTypes { name } } r: __type(name: "RPSLObject") { possibleTypes { name } } n: __type(name: "Nope") { name } }
@end

@gql
{ __typename q: __typename }
@end

@gql
{ __schema { types { fields { type { fields { type { fields { name } } } } } } } }
@end

@tags rpslobjects
@limit 10
