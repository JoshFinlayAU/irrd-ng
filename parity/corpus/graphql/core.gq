@end

@gql
{ rpslObjects(rpslPk: "{route4.prefix}{route4.origin}") { __typename rpslPk source ... on RPSLRoute { route origin prefix prefixLength asn rpkiStatus routePreferenceStatus ipFirst ipLast rpkiMaxLength descr mntBy memberOf } } }
@end

