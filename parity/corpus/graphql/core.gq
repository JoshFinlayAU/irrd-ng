@end

@tags status
@limit 1
@gql
{ databaseStatus { source source_type authoritative objectClassFilter rpkiRovFilter scopefilterEnabled routePreference localJournalKept serialOldestJournal serialNewestJournal serialLastExport serialNewestMirror nrtm4ClientSessionId nrtm4ClientVersion nrtm4ServerSessionId nrtm4ServerVersion nrtm4ServerLastUpdateNotificationFileUpdate nrtm4ServerLastSnapshotVersion rpslDataUpdated lastUpdate synchronisedSerials aliased_sources } }
@end

@gql
{ databaseStatus(sources: ["RADB", "RIRS", "NOPE"]) { source source_type aliased_sources } }
@end

@gql
{ databaseStatus(sources: ["RIRS"]) { source authoritative } }
@end

@tags variables
@limit 3
@gql
query($pk: [String!]) { rpslObjects(rpslPk: $pk) { rpslPk source } }
@variables {"pk": ["{aut_num}"]}
@end

@gql
query($names: [String!]!) { recursiveSetMembers(setNames: $names, depth: 1) { rpslPk rootSource members } }
@variables {"names": ["{as_set}"]}
@end

@gql
query($asn: [ASN!]) { r: rpslObjects(asn: $asn, objectClass: ["route", "route6"], rpkiStatus: [valid, invalid, not_found]) { rpslPk source ... on RPSLRoute { prefix asn } ... on RPSLRoute6 { prefix asn } } }
@variables {"asn": ["{origin4|digits}"]}
@end

@gql
query($p0: IP!) { q0: rpslObjects(ipAny: $p0, objectClass: ["route"], rpkiStatus: [valid, invalid, not_found]) { rpslPk source ... on RPSLRoute { prefix asn } } }
@variables {"p0": "{route4.prefix}"}
@end

@gql
query($ip: IP) { rpslObjects(ipExact: $ip) { rpslPk } }
@variables {"ip": "{route4.prefix}"}
@end

@gql
query($n: Int = 2, $t: Boolean = false) { rpslObjects(mntBy: "{mntner_busy}", recordLimit: $n, sqlTrace: $t) { rpslPk } }
@end

@gql
query($n: Int) { rpslObjects(mntBy: "{mntner_busy}", recordLimit: $n) { rpslPk } }
@variables {"n": "abc"}
@end

@gql
query($ip: IP) { rpslObjects(ipExact: $ip) { rpslPk } }
@variables {"ip": "999.1.1.1"}
@end

@gql
query($a: [ASN!]) { rpslObjects(asn: $a) { rpslPk } }
@variables {"a": ["AS65000", 1.5, {"x": 1}]}
@end

@gql
query($s: [RPKIStatus!]) { rpslObjects(objectClass: "route", rpkiStatus: $s) { rpslPk } }
@variables {"s": ["valid", "bogus"]}
@end

@gql
query($x: String!) { __typename }
@end

@gql
query($x: String!) { rpslObjects(textSearch: $x) { rpslPk } }
@variables {"x": null}
@end

@gql Two
query One { __typename } query Two { databaseStatus(sources: ["RADB"]) { source } }
@end

@gql
query One { __typename } query Two { __typename }
@end

@gql Nope
query One { __typename }
@end

@tags skipinclude
@gql
query($s: Boolean!) { rpslObjects(rpslPk: "{aut_num}") { rpslPk source @skip(if: $s) objectClass @include(if: $s) } }
@variables {"s": true}
@end

@gql
{ rpslObjects(rpslPk: "{aut_num}") { rpslPk ... on RPSLAutNum @include(if: false) { asn } ... @skip(if: false) { source } } }
@end
